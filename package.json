{
  "name": "simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "rate-card": "node --experimental-strip-types scripts/build-rate-card.ts",
    "backtest": "node --experimental-strip-types scripts/backtest.ts",
    "sanity": "node --experimental-strip-types scripts/sanity.ts",
    "validate-artifact": "node scripts/validate-artifact.mjs",
    "validate-privacy": "node scripts/validate-privacy.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "linkedom": "0.18.14",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
