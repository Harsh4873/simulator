{
  "name": "simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "rate-card": "node --experimental-strip-types scripts/build-rate-card.ts",
    "slates": "node --experimental-strip-types scripts/build-slates.ts",
    "picks": "node --experimental-strip-types scripts/build-picks.ts",
    "daily": "node --experimental-strip-types scripts/build-daily.ts",
    "matchups": "node --experimental-strip-types scripts/build-matchups.ts",
    "calibrate-props": "node --experimental-strip-types scripts/fit-prop-calibration.ts",
    "picks:backfill": "node --experimental-strip-types scripts/backfill-picks.ts",
    "backtest": "node --experimental-strip-types scripts/backtest.ts",
    "sanity": "node --experimental-strip-types scripts/sanity.ts",
    "validate-artifact": "node scripts/validate-artifact.mjs",
    "validate-privacy": "node scripts/validate-privacy.mjs",
    "replay": "node --experimental-strip-types scripts/archive-replay.ts",
    "walk-forward": "node --experimental-strip-types scripts/walk-forward.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "linkedom": "0.18.14",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
